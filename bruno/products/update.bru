meta {
  name: Update Product
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/products/{{productId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{authToken}}
}

body:json {
  {
    "name": "Produto Atualizado",
    "sku": "TEST-001",
    "barcode": "7891234567890",
    "description": "Descrição atualizada",
    "unit": "UN",
    "quantityPerBox": 12,
    "weight": 0.5,
    "brand": "Marca Teste",
    "category": "Categoria Teste",
    "cost": 12.00,
    "price": 30.00,
    "stockQty": 80,
    "active": true,
    "status": "ATIVO"
  }
}
