meta {
  name: Create Sale
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/sales
  body: json
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{authToken}}
}

body:json {
  {
    "createdBy": "admin",
    "paymentMethod": "DINHEIRO",
    "customerName": "Cliente Teste",
    "discount": 5.00,
    "items": [
      {
        "productId": "{{productId}}",
        "quantity": 2,
        "unitPrice": 25.00,
        "discount": 0.50
      }
    ]
  }
}