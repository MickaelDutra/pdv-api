meta {
  name: Create Sale
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/sales
  body: json
}

headers {
  - name: Content-Type
    value: application/json
  - name: Authorization
    value: Bearer {{authToken}}
}

body:json {
  {
    "createdBy": "admin",
    "paymentMethod": "DINHEIRO",
    "customerName": "Cliente Teste",
    "discount": 5.00,
    "items": [
      {
        "productId": "{{productId}}",
        "quantity": 2,
        "unitPrice": 25.00,
        "discount": 0.50
      }
    ]
  }
}