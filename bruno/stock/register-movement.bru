meta {
  name: Register Stock Movement
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/stock/movements
  body: json
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{authToken}}
}

body:json {
  {
    "productId": "{{productId}}",
    "type": "ENTRADA",
    "quantity": 50,
    "createdBy": "admin",
    "notes": "Entrada de estoque inicial"
  }
}