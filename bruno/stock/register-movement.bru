meta:
  name: Register Stock Movement
  type: http
  seq: 1
post:
  url: {{baseUrl}}/api/stock/movements
  params: []
  headers:
    - name: Content-Type
      value: application/json
    - name: Authorization
      value: Bearer {{authToken}}
  auth:
    type: none
  body:
    type: json
    raw: |
      {
        "productId": "{{productId}}",
        "type": "ENTRADA",
        "quantity": 50,
        "createdBy": "admin",
        "notes": "Entrada de estoque inicial"
      }